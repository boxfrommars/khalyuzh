<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="{% block description %}Дневник {{ pet.nameGenitive }}{% endblock %}">
  <title>{% block title %}{{ pet.name }}{% endblock %}</title>
  <link rel="stylesheet" href="/assets/app.css">
</head>

<body>
  <main{% if active_section == 'report' %} class="report-main"{% endif %}>
    <nav class="site-nav" aria-label="Разделы дневника">
      <a class="site-nav-link" href="{{ is_admin ? '/admin/' : '/' }}"
         {% if active_section == 'food' %}aria-current="page"{% endif %}>Рацион</a>
      <a class="site-nav-link" href="{{ is_admin ? '/admin/weight/' : '/weight/' }}"
         {% if active_section == 'weight' %}aria-current="page"{% endif %}>Вес</a>
      <a class="site-nav-link" href="/report/"
         {% if active_section == 'report' %}aria-current="page"{% endif %}>Отчёт</a>
    </nav>

    {% block content %}{% endblock %}
  </main>

  <script id="page-config" type="application/json">{{ page_config|raw }}</script>
  {% block script %}{% endblock %}
</body>
</html>
