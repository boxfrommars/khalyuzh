{% extends 'base.html.twig' %}

{% block title %}Вес Халюжа{% endblock %}
{% block description %}Дневник веса Халюжа{% endblock %}

{% block content %}
  <section class="card" aria-labelledby="page-title">
    <header class="page-header">
      <h1 id="page-title">Халюж, сколько вешаем?</h1>
      <p class="subtitle">{{ is_admin
        ? 'Запишите сегодняшнее взвешивание или исправьте прошлую запись.'
        : 'Последнее взвешивание и динамика веса Халюжа.' }}</p>
    </header>

    {% if is_admin %}
      <form id="weight-form" autocomplete="off" novalidate>
        <div class="field">
          <label for="entry-date">Дата взвешивания</label>
          <div class="input-wrap">
            <input id="entry-date" name="entryDate" type="date" required>
          </div>
          <p class="hint">По умолчанию выбрана сегодняшняя дата</p>
        </div>

        <div class="field">
          <label for="weight-kg">Вес</label>
          <div class="input-wrap">
            <input id="weight-kg" name="weightKg" type="number" inputmode="decimal"
                   min="0.01" step="0.01" placeholder="5,50" required>
            <span class="unit" aria-hidden="true">кг</span>
          </div>
        </div>

        <div class="actions">
          <button class="primary-button" id="save-button" type="submit">Сохранить вес</button>
          <p class="feedback" id="feedback" role="status"></p>
        </div>
      </form>
    {% else %}
      <section class="result latest-weight" id="latest-weight" aria-live="polite" hidden>
        <p class="result-label">Последнее взвешивание</p>
        <p class="total" id="latest-weight-value">—</p>
        <p class="status" id="latest-weight-date"></p>
      </section>
      <p class="empty-latest" id="empty-latest" hidden>Измерений пока нет.</p>
    {% endif %}
  </section>

  <section class="card" aria-labelledby="history-title">
    <header class="history-header">
      <h2 id="history-title">История</h2>
      <div class="history-average" id="history-average" aria-live="polite" hidden>
        <p class="history-average-label">Среднее за 7 дней</p>
        <strong class="history-average-value weight-average-value" id="history-average-value"></strong>
      </div>
    </header>
    <div class="history-list" id="history-list"></div>
  </section>
{% endblock %}

{% block script %}
  <script type="module" src="/assets/weight.js"></script>
{% endblock %}
